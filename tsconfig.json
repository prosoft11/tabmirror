{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowJs": true,
    "types": ["node", "chrome", "vitest/globals"]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/contracts/src/**/*.ts",
    "packages/contracts/generated/**/*.d.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "infra/**/*.ts"
  ]
}
