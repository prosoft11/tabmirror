{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tabmirror:snapshot:v1",
  "title": "TabMirror snapshot upload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "browserSessionId",
    "revision",
    "capturedAt",
    "omittedTabCount",
    "windows"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "browserSessionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "omittedTabCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "windows": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/window"
      }
    }
  },
  "$defs": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "focused", "tabs", "groups"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "focused": {
          "type": "boolean"
        },
        "tabs": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/tab"
          },
          "minItems": 1
        },
        "groups": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/group"
          }
        }
      }
    },
    "tab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "index", "groupId", "title", "url", "pinned"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "groupId": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 8192
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "maxLength": 65536
        },
        "pinned": {
          "type": "boolean"
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "color", "collapsed"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "title": {
          "type": "string",
          "maxLength": 1024
        },
        "color": {
          "enum": [
            "grey",
            "blue",
            "red",
            "yellow",
            "green",
            "pink",
            "purple",
            "cyan",
            "orange"
          ]
        },
        "collapsed": {
          "type": "boolean"
        }
      }
    }
  }
}
